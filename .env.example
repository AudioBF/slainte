# Deprecated client-side Gemini key.
# Sprint 1A/1B route meal photo analysis and shopping list through Supabase Edge Functions.
# Sprint 1C can route meal plan through Edge behind EXPO_PUBLIC_USE_EDGE_MEAL_PLAN.
# Keep this temporarily for meal plan rollback while the Edge path is validated.
EXPO_PUBLIC_GEMINI_API_KEY=

# Set to "false" to use real AI calls (default: mock mode)
EXPO_PUBLIC_AI_MOCK=true

# Set to "true" to use Supabase Edge Function for meal plan generation.
# Keep "false" or unset to use the temporary client-side Gemini rollback path.
EXPO_PUBLIC_USE_EDGE_MEAL_PLAN=false

# Macro/calorie consistency gate in Profile save.
# Default OFF when unset — only "true" enables blocking of inconsistent nutrition edits.
# ON ("true"): block save when the user changes calories/macros to an Atwater-inconsistent set.
#             Legacy inconsistent goals still load; name/photo/preferences can be saved.
# OFF (unset / "false" / any other value): save behavior matches pre-Sprint-1 (no block).
# Flag does NOT control: Atwater helpers, inline warning, manual "Recalcular carboidratos",
# or deterministic meal-plan payload normalization (store is never mutated).
# EXPO_PUBLIC_USE_MACRO_CONSISTENCY=true
EXPO_PUBLIC_USE_MACRO_CONSISTENCY=

# Day-type nutrition targets (Sprint 2A domain; UI in 2B/2C).
# Default OFF when unset — only the exact string "true" enables resolution by day type.
# OFF (unset / "false" / any other value): app keeps using profile.dailyGoals only.
# Do not enable in production until Sprint 2C integration is approved.
# EXPO_PUBLIC_USE_DAY_TARGETS=true
EXPO_PUBLIC_USE_DAY_TARGETS=

# Supabase (Fase 4) — https://supabase.com/dashboard
# Run supabase/schema.sql in the SQL Editor after creating a project
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Function secret (do NOT put this in Expo/Vercel public env):
# supabase secrets set GEMINI_API_KEY=AIza...
